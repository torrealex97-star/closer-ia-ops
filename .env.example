# Optional local configuration. Export these before npm run dev.
CAREER_ORG_ID=local-wdc
CAREER_ORG_NAME=Women Digital Closer
# CAREER_DB=/absolute/path/to/career.sqlite3
# CAREER_PYTHON=/absolute/path/to/python3.12
# The launcher generates CAREER_LOCAL_TOKEN; do not expose it to the browser.

# Sala de práctica (opcional, apagada por defecto). Sin GROQ_API_KEY la ruta responde
# 503 y la UI lo dice; nunca se simula una conversación sin proveedor.
# GROQ_API_KEY=<server-secret>        # Sites/Vercel → Secrets, nunca en el repo
# PRACTICE_MODEL=openai/gpt-oss-20b   # allowlist: gpt-oss-20b | gpt-oss-120b
# PRACTICE_DAILY_TURNS=400            # tope global por instancia y día
# GROQ_BASE_URL=https://api.groq.com/openai/v1  # solo para pruebas o pasarela propia
