{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "closer-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  // La web solo existe en su dominio. `workers.dev` queda apagado para producción; las vistas previas
  // siguen disponibles. El cron llama por `app.womendigitalclosers.com` y el motor por binding, así que
  // nada depende de esta URL.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // El Worker no puede llamar al workers.dev del motor por red (se pierde la petición). El binding
  // resuelve dentro de la plataforma; `CAREER_ENGINE_URL` sigue siendo el destino en Vercel.
  "services": [
    {
      "binding": "ENGINE",
      "service": "closer-engine"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "SUPABASE_URL": "https://jzchuizybyubtkownhlw.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_C14EqkImxzVs0qOxBY_gEQ_Sdi78dhR",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imp6Y2h1aXp5Ynl1YnRrb3duaGx3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTIxNTUwOTUsImV4cCI6MjEwNzczMTA5NX0.1BzwpmvTxzS8K_8MzH1oYKbgHuaxQbp1P-kb5yoDZAE",
    "NEXT_PUBLIC_SUPABASE_URL": "https://jzchuizybyubtkownhlw.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imp6Y2h1aXp5Ynl1YnRrb3duaGx3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTIxNTUwOTUsImV4cCI6MjEwNzczMTA5NX0.1BzwpmvTxzS8K_8MzH1oYKbgHuaxQbp1P-kb5yoDZAE",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_C14EqkImxzVs0qOxBY_gEQ_Sdi78dhR",
