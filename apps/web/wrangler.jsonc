{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "closer-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  // La web solo existe en su dominio. `workers.dev` queda apagado para producción; las vistas previas
  // siguen disponibles. El cron llama por `app.womendigitalclosers.com` y el motor por binding, así que
  // nada depende de esta URL.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // El Worker no puede llamar al workers.dev del motor por red (se pierde la petición). El binding
  // resuelve dentro de la plataforma; `CAREER_ENGINE_URL` sigue siendo el destino en Vercel.
  "services": [
    {
      "binding": "ENGINE",
      "service": "closer-engine"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Aquí solo van valores públicos que no son credenciales. Las claves de Supabase NO se versionan:
  // `tests/secrets.mjs` falla si aparecen en el repositorio (y con razón). Se cargan una vez con
  // `npx wrangler secret put <NOMBRE>` — `SUPABASE_SERVICE_ROLE_KEY`, `SUPABASE_SECRET_KEY`,
  // `ADMIN_SECRETS_KEY`, `CAREER_ADMIN_TOKEN`, `CRON_SECRET`, `SUPABASE_URL`, `SUPABASE_PUBLISHABLE_KEY`,
  // `NEXT_PUBLIC_SUPABASE_URL`, `NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY` — y sobreviven a los despliegues.
  // Las claves `anon` legacy ya NO se usan: Auth acepta la publicable (`invalid_credentials`, no
  // «invalid api key»), así que revocar las legacy en Supabase no rompe nada de este despliegue.
  "vars": {
    "ADMIN_PUBLIC_URL": "https://app.womendigitalclosers.com",
    "CAREER_ENGINE_URL": "https://closer-engine.women-digital-closers.workers.dev"
  }
}
