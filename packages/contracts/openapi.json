  "components": {
    "schemas": {
      "Configuration": {
        "properties": {
          "organization": {
            "type": "string",
            "title": "Organization"
          },
          "product_name": {
            "type": "string",
            "title": "Product Name"
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "default": "local"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceInfo"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "type": "object",
        "required": [
          "organization",
          "product_name",
          "sources"
        ],
        "title": "Configuration"
      },
      "ConnectionInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "source": {
            "type": "string",
            "maxLength": 60,
            "title": "Source",
            "default": "custom"
          },
          "actor_id": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[a-zA-Z0-9_~/-]*$",
            "title": "Actor Id",
            "default": ""
          },
          "dataset_id": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "title": "Dataset Id",
            "default": ""
          },
          "token": {
            "anyOf": [
              {
                "type": "string",
                "format": "password",
                "writeOnly": true
              },
              {
                "type": "null"
              }
            ],
            "title": "Token"
          },
          "clear_token": {
            "type": "boolean",
            "title": "Clear Token",
            "default": false
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": true
          },
          "urls": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Urls"
          },
          "url_field": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
            "title": "Url Field",
            "default": "startUrls"
          },
          "url_format": {
            "type": "string",
            "pattern": "^(objects|strings|single)$",
            "title": "Url Format",
            "default": "objects"
          },
          "actor_input": {
            "additionalProperties": true,
            "type": "object",
            "title": "Actor Input"
          },
          "mapping": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Mapping"
          },
          "max_items": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Max Items",
            "default": 100
          },
          "max_charge_usd": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.1,
            "title": "Max Charge Usd",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ConnectionInput"
      },
      "ExportRequest": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "job_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
            "title": "Job Ids"
          },
          "format": {
            "type": "string",
            "enum": [
              "csv",
              "json",
              "xlsx"
            ],
            "title": "Format"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "job_ids",
          "format"
        ],
        "title": "ExportRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Job": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "company": {
            "type": "string",
            "title": "Company"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "application_url": {
            "type": "string",
            "title": "Application Url"
          },
          "locations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Locations"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "salary_min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Salary Min"
          },
          "salary_max": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Salary Max"
          },
          "salary_currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Salary Currency"
          },
          "salary_period": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Salary Period"
          },
          "score": {
            "type": "integer",
            "title": "Score"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "raw_id": {
            "type": "string",
            "title": "Raw Id"
          },
          "captured_at": {
            "type": "string",
            "title": "Captured At"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "starred": {
            "type": "boolean",
            "title": "Starred",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "company",
          "description",
          "source",
          "source_url",
          "application_url",
          "locations",
          "published_at",
          "score",
          "reasons",
          "warnings",
          "raw_id",
          "captured_at",
          "provider"
        ],
        "title": "Job"
      },
      "ResolveRequest": {
        "properties": {
